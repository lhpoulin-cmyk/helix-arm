diff --git a/arm/ripper/movie_selection.py b/arm/ripper/movie_selection.py
new file mode 100644
index 0000000..067b7c7
--- /dev/null
+++ b/arm/ripper/movie_selection.py
@@ -0,0 +1,57 @@
+"""Pure MakeMKV movie policy. Parsing, database access and ripping live elsewhere."""
+import hashlib
+import json
+
+
+def select_movie(titles, config, job_id, video_type='movie'):
+    """Return a logged decision or operator choices; never read a disc or rip.
+
+    Manual YAML choices bind both the ARM job ID and the exact normalized title
+    inventory. The fingerprint is an inventory binding, not a physical disc ID.
+    """
+    rows = sorted(titles, key=lambda row: row['title_id'])
+    fingerprint = hashlib.sha256(json.dumps(rows, sort_keys=True,
+                                            separators=(',', ':')).encode()).hexdigest()
+    strategy = config.get('MOVIE_SELECTION_STRATEGY', 'explicit')
+    fallback = config.get('MOVIE_SELECTION_FALLBACK', 'manual')
+    result = dict(strategy=strategy, fallback=fallback, job_id=job_id,
+                  inventory_sha256=fingerprint, policy=None, title_id=None,
+                  reason=None, candidates=rows)
+
+    def decision(policy, reason, title=None):
+        result.update(policy=policy, reason=reason,
+                      title_id=None if title is None else title['title_id'])
+        return result
+
+    if strategy not in ('explicit', 'heuristic', 'manual') or fallback not in ('manual', 'heuristic'):
+        return decision('operator', 'INVALID_POLICY')
+    if not rows or len({r['title_id'] for r in rows}) != len(rows):
+        return decision('operator', 'INVALID_INVENTORY')
+    if video_type != 'movie':
+        return decision('operator', 'MOVIE_CLASSIFICATION_REQUIRED')
+
+    explicit = [row for row in rows if row['main_feature']]
+    reason = ('EXPLICIT_AMBIGUOUS' if explicit or any(r['identification_conflict'] for r in rows)
+              else 'EXPLICIT_UNAVAILABLE')
+    if strategy == 'explicit':
+        if len(explicit) == 1 and not any(r['identification_conflict'] for r in rows):
+            return decision('explicit', 'UNIQUE_TINFO_49_FPL_MAINFEATURE', explicit[0])
+        strategy = fallback
+    if strategy == 'heuristic':
+        # Preserve upstream order: chapters DESC, bytes DESC, title number ASC.
+        title = min(rows, key=lambda r: (-r['chapters'], -r['size_bytes'], r['title_id']))
+        return decision('heuristic', reason + '_FALLBACK' if result['strategy'] == 'explicit'
+                        else 'CHAPTERS_SIZE_TITLE_ID', title)
+
+    manual_job = config.get('MOVIE_SELECTION_MANUAL_JOB_ID', -1)
+    manual_inventory = config.get('MOVIE_SELECTION_MANUAL_INVENTORY_SHA256', '')
+    manual_title = config.get('MOVIE_SELECTION_MANUAL_TITLE_ID', -1)
+    if (type(manual_job) is int and manual_job == job_id and manual_inventory == fingerprint
+            and type(manual_title) is int):
+        matches = [r for r in rows if r['title_id'] == manual_title]
+        if len(matches) == 1:
+            return decision('manual', 'JOB_AND_INVENTORY_BOUND_OVERRIDE', matches[0])
+        return decision('operator', 'MANUAL_TITLE_NOT_FOUND')
+    if manual_job != -1 or manual_inventory or manual_title != -1:
+        return decision('operator', 'MANUAL_SCOPE_MISMATCH')
+    return decision('operator', reason if result['strategy'] == 'explicit' else 'MANUAL_REQUESTED')
