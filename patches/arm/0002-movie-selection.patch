+"""Pinned parser + policy + routing tests; no Flask, devices or live workload."""
+import copy
+import dataclasses
+import enum
+import importlib.util
+import json
+import logging
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import Mock
+from test_reliability import load, ROOT
+
+spec = importlib.util.spec_from_file_location('movie_selection', ROOT / 'arm/ripper/movie_selection.py')
+policy = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(policy)
+FIXTURE = json.loads((Path(__file__).parent / 'fixtures/movie-139.json').read_text())
+
+
+def parse_fixture(fixture=FIXTURE):
+    tracks = []
+    def put(job, tid, seconds, aspect, fps, main, source, filename, chapters, size):
+        tracks.append(NS(track_number=tid, length=seconds, filename=filename,
+                         main_feature=main, process=True))
+    job = NS(no_of_titles=None, tracks=tracks)
+    utils = NS(put_track=put, database_updater=lambda values, j: j.__dict__.update(values))
+    ns = load('arm/ripper/makemkv.py', {'StreamID', 'TrackID', 'Titles', 'CInfo', 'TInfo', 'SInfo',
+              'TrackInfoProcessor', 'convert_to_seconds'}, dict(enum=enum, dataclasses=dataclasses,
+              logging=logging, utils=utils, SOURCE='MakeMKV', MAKEMKV_STREAM_CODE_TYPE_VIDEO=6201))
+    processor = ns['TrackInfoProcessor'](job, 0)
+    processor._process_message(ns['Titles'](fixture['title_count']))
+    for row in fixture['titles']:
+        for attr, value in row['attributes'].items():
+            processor._process_message(ns['TInfo'](id=int(attr), code=0, value=value, tid=row['title_id']))
+    processor._add_track()
+    return processor.inventory, job, ns
+
+
+class MovieSelection(unittest.TestCase):
+    def setUp(self):
+        self.rows, self.job, self.parser = parse_fixture()
+
+    def choose(self, rows=None, **config):
+        return policy.select_movie(self.rows if rows is None else rows, config, 4)
+
+    def test_retained_139_explicit_marker_beats_larger_title(self):
+        result = self.choose()
+        self.assertEqual(len(result['candidates']), 139)
+        self.assertEqual((result['policy'], result['title_id']), ('explicit', 32))
+        chosen = self.rows[32]
+        self.assertEqual((chosen['source_file'], chosen['duration_seconds']), ('00609.mpls', 6161))
+        self.assertEqual(result['reason'], 'UNIQUE_TINFO_49_FPL_MAINFEATURE')
+        self.assertTrue(self.job.tracks[32].main_feature)
+        self.assertFalse(self.job.tracks[33].main_feature)  # parser reset
+        self.assertEqual(self.choose(MOVIE_SELECTION_STRATEGY='heuristic')['title_id'], 128)
+
+    def test_absent_marker_does_not_infer_from_filename_or_size(self):
+        rows = copy.deepcopy(self.rows)
+        rows[32]['main_feature'] = False
+        result = self.choose(rows)
+        self.assertIsNone(result['title_id'])
+        self.assertEqual(result['reason'], 'EXPLICIT_UNAVAILABLE')
+        self.assertEqual(len(result['candidates']), 139)
+        self.assertEqual(self.choose(rows, MOVIE_SELECTION_FALLBACK='heuristic')['title_id'], 128)
+
+    def test_conflicting_candidates_require_operator(self):
+        rows = copy.deepcopy(self.rows)
+        rows[128]['main_feature'] = True
+        self.assertIsNone(self.choose(rows)['title_id'])
+        self.assertEqual(self.choose(rows)['reason'], 'EXPLICIT_AMBIGUOUS')
+        rows[128]['main_feature'] = False
+        rows[32]['identification_conflict'] = True
+        self.assertIsNone(self.choose(rows)['title_id'])
+
+    def test_not_hardcoded_to_title_32(self):
+        rows = copy.deepcopy(self.rows)
+        rows[32]['main_feature'] = False
+        rows[70]['main_feature'] = True
+        self.assertEqual(self.choose(rows)['title_id'], 70)
+
+    def test_manual_override_binds_job_and_inventory_and_preserves_zero(self):
+        config = dict(MOVIE_SELECTION_STRATEGY='manual', MOVIE_SELECTION_MANUAL_JOB_ID=4,
+                      MOVIE_SELECTION_MANUAL_INVENTORY_SHA256=self.choose()['inventory_sha256'],
+                      MOVIE_SELECTION_MANUAL_TITLE_ID=0)
+        self.assertEqual(self.choose(**config)['title_id'], 0)
+        self.assertIsNone(policy.select_movie(self.rows, config, 5)['title_id'])
+        rows = copy.deepcopy(self.rows)
+        rows[0]['source_file'] = 'different-disc.mpls'
+        self.assertIsNone(self.choose(rows, **config)['title_id'])
+        config['MOVIE_SELECTION_MANUAL_TITLE_ID'] = 999
+        self.assertEqual(self.choose(**config)['reason'], 'MANUAL_TITLE_NOT_FOUND')
+        config['MOVIE_SELECTION_MANUAL_TITLE_ID'] = True
+        self.assertIsNone(self.choose(**config)['title_id'])
+
+    def test_heuristic_tie_uses_numeric_title_id_not_list_order(self):
+        rows = [dict(self.rows[0], title_id=i) for i in (10, 2)]
+        self.assertEqual(self.choose(rows, MOVIE_SELECTION_STRATEGY='heuristic')['title_id'], 2)
+
+    def test_invalid_policy_and_unknown_media_do_not_auto_select(self):
+        self.assertIsNone(self.choose(MOVIE_SELECTION_STRATEGY='largest')['title_id'])
+        self.assertIsNone(self.choose(MOVIE_SELECTION_FALLBACK='explicit')['title_id'])
+        self.assertIsNone(policy.select_movie(self.rows, {}, 4, 'unknown')['title_id'])
+        self.assertIsNone(self.choose([])['title_id'])
+
+    def test_parser_never_treats_filename_or_near_marker_as_identification(self):
+        fixture = copy.deepcopy(FIXTURE)
+        fixture['titles'][32]['attributes']['49'] = 'FPL_MainFeature_extra'
+        rows, _, _ = parse_fixture(fixture)
+        self.assertIsNone(self.choose(rows)['title_id'])
+        del fixture['titles'][32]['attributes']['49']
+        rows, _, _ = parse_fixture(fixture)
+        self.assertIsNone(self.choose(rows)['title_id'])
+
+    def routing(self, kind='movie', config=None, wait=None, rows=None):
+        job = self.job
+        job.__dict__.update(video_type=kind, job_id=4, devpath='/dev/synthetic', drive=NS(mdisc=0),
+                            config=NS(MAINFEATURE=False, MAXLENGTH=99998), manual_start=True)
+        ns = dict(utils=NS(get_drive_mode=lambda _: 'auto', RipperException=RuntimeError),
+                  logging=logging, json=json, cfg=NS(arm_config=config or {}), select_movie=policy.select_movie,
+                  get_track_info=Mock(return_value=self.rows if rows is None else rows),
+                  rip_mainfeature=Mock(), process_single_tracks=Mock(), manual_wait=Mock(side_effect=wait or (lambda _: False)),
+                  db=NS(session=Mock()), JobState=NS(VIDEO_WAITING=NS(value='waiting'), VIDEO_RIPPING=NS(value='ripping')))
+        load('arm/ripper/makemkv.py', {'makemkv_mkv'}, ns)
+        return job, ns
+
+    def test_movie_routing_uses_policy_even_when_mainfeature_false(self):
+        job, ns = self.routing()
+        ns['makemkv_mkv'](job, '/unused')
+        self.assertEqual(ns['rip_mainfeature'].call_args.args[1].track_number, 32)
+        ns['manual_wait'].assert_not_called()
+        ns['process_single_tracks'].assert_not_called()
+
+    def test_missing_identification_waits_and_clears_stale_choices(self):
+        rows = copy.deepcopy(self.rows)
+        rows[32]['main_feature'] = False
+        job, ns = self.routing(rows=rows)
+        with self.assertRaisesRegex(RuntimeError, 'operator input'):
+            ns['makemkv_mkv'](job, '/unused')
+        self.assertFalse(job.manual_start)
+        self.assertFalse(any(t.process for t in job.tracks))
+        ns['rip_mainfeature'].assert_not_called()
+
+    def test_operator_selection_is_exactly_one_current_title(self):
+        def wait(job):
+            self.assertFalse(any(t.process for t in job.tracks))
+            job.tracks[7].process = True
+            return True
