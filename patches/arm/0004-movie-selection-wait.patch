diff --git a/test/local/test_movie_selection.py b/test/local/test_movie_selection.py
index ad71dcb..66ce423 100644
--- a/test/local/test_movie_selection.py
+++ b/test/local/test_movie_selection.py
@@ -234,3 +234,40 @@ class ManualSelectionUI(unittest.TestCase):
     def test_series_manual_ui_behavior_unchanged(self):
         self.assertFalse(self.page(kind='series')['manual_edit'])
         self.assertTrue(self.page(kind='series', manual=True)['manual_edit'])
+
+
+class MovieSelectionWait(unittest.TestCase):
+    def run_wait(self, config, choose_at=None, oversleep=0):
+        clock=[0.0];sleeps=[]
+        job=NS(job_id=4, manual_start=False, video_type='unknown')
+        def sleep(seconds):
+            sleeps.append(seconds);clock[0]+=seconds+oversleep
+        def refresh(job):
+            job.manual_start=choose_at is not None and clock[0]>=choose_at
+        ns=dict(cfg=NS(arm_config=config), utils=NS(RipperException=ValueError),
+                logging=logging, notify=Mock(), monotonic=lambda:clock[0], sleep=sleep,
+                db=NS(session=NS(refresh=refresh)))
+        load('arm/ripper/makemkv.py', {'movie_selection_wait'}, ns)
+        result=ns['movie_selection_wait'](job)
+        return result,clock[0],sleeps
+
+    def test_testing_timeout_is_sixty_seconds_without_selection(self):
+        result,elapsed,sleeps=self.run_wait({'MOVIE_SELECTION_WAIT_SECONDS':60})
+        self.assertFalse(result);self.assertEqual(elapsed,60);self.assertEqual(max(sleeps),5)
+
+    def test_default_remains_thirty_minutes_and_start_is_prompt(self):
+        self.assertEqual(self.run_wait({})[:2],(False,1800))
+        self.assertEqual(self.run_wait({'MOVIE_SELECTION_WAIT_SECONDS':60},choose_at=5)[:2],(True,5))
+
+    def test_invalid_values_and_late_start_cannot_extend_deadline(self):
+        for value in (True,0,-1,4,1801,'60',None):
+            with self.assertRaises(ValueError):self.run_wait({'MOVIE_SELECTION_WAIT_SECONDS':value})
+        self.assertEqual(self.run_wait({'MOVIE_SELECTION_WAIT_SECONDS':60},choose_at=1,oversleep=60)[0],False)
+
+    def test_tv_keeps_original_wait_and_never_reads_movie_timeout(self):
+        job=NS(video_type='series',manual_start=False);sleeps=[]
+        ns=dict(movie_selection_wait=Mock(side_effect=AssertionError('TV changed')),
+                notify=Mock(),sleep=sleeps.append,logging=logging,db=NS(session=Mock()))
+        load('arm/ripper/makemkv.py', {'manual_wait'}, ns)
+        self.assertFalse(ns['manual_wait'](job));self.assertEqual(sleeps,[60]*30)
+        ns['movie_selection_wait'].assert_not_called()
