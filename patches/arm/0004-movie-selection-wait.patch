diff --git a/arm/ripper/makemkv.py b/arm/ripper/makemkv.py
index 43c5717..f01c567 100644
--- a/arm/ripper/makemkv.py
+++ b/arm/ripper/makemkv.py
@@ -18,7 +18,7 @@ import re
 import shlex
 import shutil
 import subprocess
-from time import sleep, time
+from time import sleep, time, monotonic
 
 import arm.config.config as cfg
 from arm.models import SystemDrives, Track
@@ -1299,6 +1299,29 @@ def run(options, select):
         raise MakeMkvRuntimeError(proc.returncode, cmd, output=os.linesep.join(buffer))
 
 
+def movie_selection_wait(job):
+    """Bounded movie-only operator wait; timeout never selects a title."""
+    seconds = cfg.arm_config.get('MOVIE_SELECTION_WAIT_SECONDS', 1800)
+    if type(seconds) is not int or not 5 <= seconds <= 1800:
+        raise utils.RipperException('MOVIE_SELECTION_WAIT_SECONDS must be an integer from 5 to 1800')
+    deadline = monotonic() + seconds
+    logging.info('MOVIE_SELECTION_WAIT job=%s timeout_seconds=%s', job.job_id, seconds)
+    notify(job, 'Movie selection required', f'Select one title within {seconds} seconds; timeout stops without ripping.')
+    while True:
+        remaining = deadline - monotonic()
+        if remaining <= 0:
+            logging.info('MOVIE_SELECTION_WAIT job=%s result=TIMEOUT', job.job_id)
+            return False
+        sleep(min(5, remaining))
+        # Do not accept a start signal after the deadline.
+        if monotonic() >= deadline:
+            logging.info('MOVIE_SELECTION_WAIT job=%s result=TIMEOUT', job.job_id)
+            return False
+        db.session.refresh(job)
+        if job.manual_start:
+            return True
+
+
 def manual_wait(job) -> bool:
     """
     Pause execution to allow for user interaction and monitor job readiness.
@@ -1322,6 +1345,9 @@ def manual_wait(job) -> bool:
         - A final notification is sent when one minute is left, warning of potential
           cancellation.
     """
+    if job.video_type != 'series':
+        return movie_selection_wait(job)
+
     user_ready = False
     wait_time: int = 30
 
