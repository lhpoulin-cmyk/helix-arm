diff --git a/arm/ripper/movie_selection.py b/arm/ripper/movie_selection.py
index 067b7c7..d082d35 100644
--- a/arm/ripper/movie_selection.py
+++ b/arm/ripper/movie_selection.py
@@ -23,11 +23,29 @@ def select_movie(titles, config, job_id, video_type='movie'):
                       title_id=None if title is None else title['title_id'])
         return result
 
+    def manual_decision(reason):
+        manual_job = config.get('MOVIE_SELECTION_MANUAL_JOB_ID', -1)
+        manual_inventory = config.get('MOVIE_SELECTION_MANUAL_INVENTORY_SHA256', '')
+        manual_title = config.get('MOVIE_SELECTION_MANUAL_TITLE_ID', -1)
+        if (type(manual_job) is int and manual_job == job_id and manual_inventory == fingerprint
+                and type(manual_title) is int):
+            matches = [r for r in rows if r['title_id'] == manual_title]
+            if len(matches) == 1:
+                return decision('manual', 'JOB_AND_INVENTORY_BOUND_OVERRIDE', matches[0])
+            return decision('operator', 'MANUAL_TITLE_NOT_FOUND')
+        if manual_job != -1 or manual_inventory or manual_title != -1:
+            return decision('operator', 'MANUAL_SCOPE_MISMATCH')
+        return decision('operator', reason)
+
     if strategy not in ('explicit', 'heuristic', 'manual') or fallback not in ('manual', 'heuristic'):
         return decision('operator', 'INVALID_POLICY')
     if not rows or len({r['title_id'] for r in rows}) != len(rows):
         return decision('operator', 'INVALID_INVENTORY')
     if video_type != 'movie':
+        # A deliberate exact job/inventory override needs no online classification.
+        # Never treat a marker as proof that an unknown disc is a movie.
+        if video_type == 'unknown' and strategy == 'manual':
+            return manual_decision('MOVIE_CLASSIFICATION_REQUIRED')
         return decision('operator', 'MOVIE_CLASSIFICATION_REQUIRED')
 
     explicit = [row for row in rows if row['main_feature']]
@@ -43,15 +61,4 @@ def select_movie(titles, config, job_id, video_type='movie'):
         return decision('heuristic', reason + '_FALLBACK' if result['strategy'] == 'explicit'
                         else 'CHAPTERS_SIZE_TITLE_ID', title)
 
