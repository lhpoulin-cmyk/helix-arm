diff --git a/arm_wiki/Movie-selection.md b/arm_wiki/Movie-selection.md
index 9b032b3..97ebd58 100644
--- a/arm_wiki/Movie-selection.md
+++ b/arm_wiki/Movie-selection.md
@@ -84,3 +84,16 @@ movie-selection testing. Movie waits poll every5seconds against a monotonic
 deadline; timeout stops without selecting or ripping. TV waits are unchanged.
 This is separate from MANUAL_WAIT_TIME (identification/MakeMKV scheduling).
 Configuration is captured by the job process; it cannot change an active wait.
+
+## Optional online metadata
+
+OMDb enriches names, year, type, IDs and posters; it is not a MakeMKV ripping
+credential. With no OMDB_API_KEY, lookup and poster helpers return no metadata
+without making an unauthenticated request. Existing disc/label values remain.
+GET_VIDEO_TITLE and METADATA_PROVIDER keep their existing roles; no alternative
+provider is selected silently. Missing type still requires operator selection.
+For an unknown disc, MOVIE_SELECTION_STRATEGY: manual can use the existing exact
+job, inventory hash and title-ID override. A stale/missing override stops; known
+series keep their existing routing. The UI also accepts exactly one current-job
+track. Explicit/heuristic policies do not classify an unknown disc from a marker.
+No guessed title order, renamed source identity or automatic enrichment is added.
diff --git a/test/local/test_movie_selection.py b/test/local/test_movie_selection.py
index 66ce423..4c3ad54 100644
--- a/test/local/test_movie_selection.py
+++ b/test/local/test_movie_selection.py
@@ -271,3 +271,44 @@ class MovieSelectionWait(unittest.TestCase):
         load('arm/ripper/makemkv.py', {'manual_wait'}, ns)
         self.assertFalse(ns['manual_wait'](job));self.assertEqual(sleeps,[60]*30)
         ns['movie_selection_wait'].assert_not_called()
+
+
+class OptionalMetadata(unittest.TestCase):
+    def api(self, key=None, present=True):
+        import urllib.request,urllib.error,urllib.parse
+        from unittest.mock import Mock
+        config={'OMDB_API_KEY':key} if present else {}
+        opener=Mock(side_effect=AssertionError('unconfigured network call'))
+        web=NS(request=NS(urlopen=opener),error=urllib.error,parse=urllib.parse)
+        ns=dict(cfg=NS(arm_config=config),app=NS(logger=Mock()),urllib=web,json=json,
+                requests=NS(utils=NS(requote_uri=lambda x:x)))
+        load('arm/ui/metadata.py', {'call_omdb_api','get_omdb_poster'}, ns)
+        return ns,opener
+
+    def test_missing_empty_and_whitespace_credentials_skip_network(self):
+        for key,present in ((None,False),(None,True),('',True),('  ',True)):
+            ns,opener=self.api(key,present)
+            self.assertIsNone(ns['call_omdb_api']('synthetic'))
+            self.assertEqual(ns['get_omdb_poster']('synthetic'),(None,None))
+            opener.assert_not_called()
+
+    def test_configured_credential_consumed_without_logging_it(self):
+        ns,opener=self.api('synthetic-test-key')
+        opener.side_effect=None;opener.return_value=NS(read=lambda: b'{"Response":"True","Search":[]}')
+        self.assertEqual(ns['call_omdb_api']('synthetic')['Response'],'True')
+        self.assertIn('apikey=synthetic-test-key',opener.call_args.args[0])
+        self.assertNotIn('synthetic-test-key',str(ns['app'].logger.mock_calls))
+
+    def test_absent_metadata_supports_only_exact_manual_override_for_unknown(self):
+        ns,opener=self.api('');self.assertIsNone(ns['call_omdb_api']('synthetic'))
+        rows,_,_=parse_fixture();preview=policy.select_movie(rows,{},4,'unknown')
+        self.assertIsNone(preview['title_id']);self.assertEqual(preview['reason'],'MOVIE_CLASSIFICATION_REQUIRED')
+        config=dict(MOVIE_SELECTION_STRATEGY='manual',MOVIE_SELECTION_MANUAL_JOB_ID=4,
+                    MOVIE_SELECTION_MANUAL_INVENTORY_SHA256=preview['inventory_sha256'],
+                    MOVIE_SELECTION_MANUAL_TITLE_ID=32)
+        selected=policy.select_movie(rows,config,4,'unknown')
+        self.assertEqual((selected['policy'],selected['title_id']),('manual',32))
+        for kind,job,changes in [('unknown',5,{}),('unknown',4,{'MOVIE_SELECTION_MANUAL_INVENTORY_SHA256':'stale'}),
+                                 ('series',4,{}),('unknown',4,{'MOVIE_SELECTION_MANUAL_TITLE_ID':999})]:
+            self.assertIsNone(policy.select_movie(rows,dict(config,**changes),job,kind)['title_id'])
+        opener.assert_not_called()
