From a72e1828b4208bf44a3028515bd079249d73a2f7 Mon Sep 17 00:00:00 2001
From: Helix ARM <helix-arm@localhost>
Date: Thu, 17 Sep 2026 00:42:22 +0000
Subject: [PATCH] Allow configured unique main-feature selection without online
 classification

---
 arm/ripper/movie_selection.py      | 23 ++++++++++------
 arm/ui/comments.json               |  1 +
 arm_wiki/Movie-selection.md        | 10 +++++++
 setup/arm.yaml                     |  2 ++
 test/local/test_movie_selection.py | 43 ++++++++++++++++++++++++++++--
 5 files changed, 69 insertions(+), 10 deletions(-)

diff --git a/arm/ripper/movie_selection.py b/arm/ripper/movie_selection.py
index d082d35..69b0a63 100644
--- a/arm/ripper/movie_selection.py
+++ b/arm/ripper/movie_selection.py
@@ -14,9 +14,11 @@ def select_movie(titles, config, job_id, video_type='movie'):
                                             separators=(',', ':')).encode()).hexdigest()
     strategy = config.get('MOVIE_SELECTION_STRATEGY', 'explicit')
     fallback = config.get('MOVIE_SELECTION_FALLBACK', 'manual')
+    allow_unknown = config.get('MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT', False)
     result = dict(strategy=strategy, fallback=fallback, job_id=job_id,
                   inventory_sha256=fingerprint, policy=None, title_id=None,
-                  reason=None, candidates=rows)
+                  reason=None, candidates=rows, video_type=video_type,
+                  allow_unknown_explicit=allow_unknown)
 
     def decision(policy, reason, title=None):
         result.update(policy=policy, reason=reason,
@@ -37,22 +39,27 @@ def select_movie(titles, config, job_id, video_type='movie'):
             return decision('operator', 'MANUAL_SCOPE_MISMATCH')
         return decision('operator', reason)
 
-    if strategy not in ('explicit', 'heuristic', 'manual') or fallback not in ('manual', 'heuristic'):
+    if (strategy not in ('explicit', 'heuristic', 'manual') or fallback not in ('manual', 'heuristic')
+            or type(allow_unknown) is not bool):
         return decision('operator', 'INVALID_POLICY')
     if not rows or len({r['title_id'] for r in rows}) != len(rows):
         return decision('operator', 'INVALID_INVENTORY')
+    explicit = [row for row in rows if row['main_feature']]
+    conflict = any(r['identification_conflict'] for r in rows)
+    unique = len(explicit) == 1 and not conflict
+    reason = 'EXPLICIT_AMBIGUOUS' if explicit or conflict else 'EXPLICIT_UNAVAILABLE'
     if video_type != 'movie':
-        # A deliberate exact job/inventory override needs no online classification.
-        # Never treat a marker as proof that an unknown disc is a movie.
+        if video_type == 'unknown' and strategy == 'explicit' and allow_unknown:
+            if unique:
+                return decision('explicit', 'UNIQUE_TINFO_49_FPL_MAINFEATURE_UNCLASSIFIED', explicit[0])
+            # Never apply a size/chapter heuristic to an unclassified disc.
+            return decision('operator', reason)
         if video_type == 'unknown' and strategy == 'manual':
             return manual_decision('MOVIE_CLASSIFICATION_REQUIRED')
         return decision('operator', 'MOVIE_CLASSIFICATION_REQUIRED')
 
-    explicit = [row for row in rows if row['main_feature']]
-    reason = ('EXPLICIT_AMBIGUOUS' if explicit or any(r['identification_conflict'] for r in rows)
-              else 'EXPLICIT_UNAVAILABLE')
     if strategy == 'explicit':
-        if len(explicit) == 1 and not any(r['identification_conflict'] for r in rows):
+        if unique:
             return decision('explicit', 'UNIQUE_TINFO_49_FPL_MAINFEATURE', explicit[0])
         strategy = fallback
     if strategy == 'heuristic':
diff --git a/arm/ui/comments.json b/arm/ui/comments.json
index e8ed118..d53a9e3 100644
--- a/arm/ui/comments.json
+++ b/arm/ui/comments.json
@@ -1,4 +1,5 @@
 {
+    "MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT": "# Boolean opt-in: select a unique MakeMKV marker with unknown metadata type; ambiguity requires an operator. Does not classify or rename the disc.",
     "MOVIE_SELECTION_WAIT_SECONDS": "# Movie operator-selection timeout: integer 5..1800 seconds; default 1800, testing 60. TV waits unchanged.",
     "MOVIE_SELECTION_STRATEGY": "# MakeMKV movie policy: explicit, heuristic, manual. See arm_wiki/Movie-selection.md.",
     "MOVIE_SELECTION_FALLBACK": "# When explicit identification is absent or ambiguous: manual (default) or heuristic.",
diff --git a/arm_wiki/Movie-selection.md b/arm_wiki/Movie-selection.md
index 97ebd58..608e8ef 100644
--- a/arm_wiki/Movie-selection.md
+++ b/arm_wiki/Movie-selection.md
@@ -97,3 +97,13 @@ job, inventory hash and title-ID override. A stale/missing override stops; known
 series keep their existing routing. The UI also accepts exactly one current-job
 track. Explicit/heuristic policies do not classify an unknown disc from a marker.
 No guessed title order, renamed source identity or automatic enrichment is added.
+
+## Explicit markers without classification
+
+MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT is a boolean, defaultfalse. With true
+and strategyexplicit, an unknown disc may select exactly one FPL_MainFeature
+marker only when no inventory identification conflict exists. Missing/multiple
+markers or conflicts always require operator input, even with heuristic fallback
+configured. This does not classify the disc as movie or invent title/year/episode
+metadata. Existing unknown naming/quarantine behavior remains. The decision logs
+video_type, opt-in policy and UNCLASSIFIED reason. Known TV routing is unchanged.
diff --git a/setup/arm.yaml b/setup/arm.yaml
index 4a711c8..5eb470b 100755
--- a/setup/arm.yaml
+++ b/setup/arm.yaml
@@ -253,6 +253,8 @@ MAINFEATURE: false
 # See arm_wiki/Movie-selection.md. TV routing remains unchanged.
 MOVIE_SELECTION_STRATEGY: explicit  # explicit | heuristic | manual
 MOVIE_SELECTION_FALLBACK: manual   # manual | heuristic
+# Opt in to a unique explicit marker when metadata type is unknown; no heuristic fallback.
+MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT: false
 # Movie operator-selection timeout in seconds (integer 5..1800); tests may use 60.
 MOVIE_SELECTION_WAIT_SECONDS: 1800
 # Optional manual override: ALL three values must match the current attempt.
diff --git a/test/local/test_movie_selection.py b/test/local/test_movie_selection.py
index 4c3ad54..6364d8f 100644
--- a/test/local/test_movie_selection.py
+++ b/test/local/test_movie_selection.py
@@ -173,7 +173,7 @@ class MovieSelection(unittest.TestCase):
         self.assertIsNone(self.choose(processor.inventory)['title_id'])
 
     def test_series_ten_titles_including_shorts_keeps_all_title_command(self):
-        job, ns = self.routing(kind='series')
+        job, ns = self.routing(kind='series', config={'MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT': True})
         job.config.MAXLENGTH = 99999
         job.config.MINLENGTH = 0
         job.config.MKV_ARGS = ''
@@ -193,7 +193,7 @@ class MovieSelection(unittest.TestCase):
 
     def test_series_keeps_existing_auto_and_manual_routing(self):
         for mode in ('auto', 'manual'):
-            job, ns = self.routing(kind='series', wait=lambda _: True)
+            job, ns = self.routing(kind='series', config={'MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT': True}, wait=lambda _: True)
             ns['utils'].get_drive_mode = lambda _: mode
             ns['select_movie'] = Mock(side_effect=AssertionError('TV entered movie selector'))
             ns['makemkv_mkv'](job, '/unused')
@@ -312,3 +312,42 @@ class OptionalMetadata(unittest.TestCase):
                                  ('series',4,{}),('unknown',4,{'MOVIE_SELECTION_MANUAL_TITLE_ID':999})]:
             self.assertIsNone(policy.select_movie(rows,dict(config,**changes),job,kind)['title_id'])
         opener.assert_not_called()
+
+
+class UnclassifiedExplicitSelection(unittest.TestCase):
+    def setUp(self):
+        self.rows,_,_=parse_fixture()
+        self.config={'MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT':True}
+
+    def test_unknown_unique_marker_selects_without_changing_metadata(self):
+        result=policy.select_movie(self.rows,self.config,7,'unknown')
+        self.assertEqual((result['policy'],result['title_id']),('explicit',32))
+        self.assertEqual(result['video_type'],'unknown')
+        self.assertEqual(result['reason'],'UNIQUE_TINFO_49_FPL_MAINFEATURE_UNCLASSIFIED')
+        self.rows[32]['main_feature']=False;self.rows[70]['main_feature']=True
+        self.assertEqual(policy.select_movie(self.rows,self.config,8,'unknown')['title_id'],70)
+
+    def test_unknown_missing_conflicting_or_multiple_markers_never_use_heuristic(self):
+        for mode in ('missing','multiple','conflict'):
+            rows=copy.deepcopy(self.rows)
+            if mode=='missing':rows[32]['main_feature']=False
+            if mode=='multiple':rows[70]['main_feature']=True
+            if mode=='conflict':rows[70]['identification_conflict']=True
+            result=policy.select_movie(rows,dict(self.config,MOVIE_SELECTION_FALLBACK='heuristic'),7,'unknown')
+            self.assertEqual(result['policy'],'operator');self.assertIsNone(result['title_id'])
+        self.assertIsNone(policy.select_movie(self.rows,dict(self.config,MOVIE_SELECTION_STRATEGY='heuristic'),7,'unknown')['title_id'])
+
+    def test_opt_in_is_strict_and_never_changes_known_series_policy(self):
+        self.assertIsNone(policy.select_movie(self.rows,{},7,'unknown')['title_id'])
+        for value in ('true',1,None):
+            self.assertEqual(policy.select_movie(self.rows,{'MOVIE_SELECTION_ALLOW_UNKNOWN_EXPLICIT':value},7,'unknown')['reason'],'INVALID_POLICY')
+        self.assertIsNone(policy.select_movie(self.rows,self.config,7,'series')['title_id'])
+        self.assertEqual(policy.select_movie(self.rows,self.config,7,'movie')['title_id'],32)
+
+    def test_unknown_routing_runs_selected_title_without_manual_wait(self):
+        case=MovieSelection();case.setUp()
+        job,ns=case.routing(kind='unknown',config=self.config)
+        ns['makemkv_mkv'](job,'/unused')
+        self.assertEqual(ns['rip_mainfeature'].call_args.args[1].track_number,32)
+        ns['manual_wait'].assert_not_called()
+        self.assertEqual(job.video_type,'unknown')
