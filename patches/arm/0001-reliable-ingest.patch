@@ -0,0 +1,227 @@
+"""Dependency-light regression tests of upstream definitions and real subprocesses.
+
+Extract exact definitions to avoid import-time Flask/database/device startup.
+Not a substitute for container/optical acceptance. Run from checkout root:
+python3 -m unittest discover -s test/local -v
+"""
+import ast
+import collections
+import datetime
+import enum
+import logging
+import logging.handlers
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import Mock, patch
+import uuid
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def load(file, names, ns):
+    tree = ast.parse((ROOT / file).read_text())
+    nodes = [n for n in tree.body if getattr(n, 'name', None) in names]
+    assert len(nodes) == len(names), names
+    exec(compile(ast.Module(nodes, type_ignores=[]), str(ROOT / file), 'exec'), ns)
+    return ns
+
+
+class Reliability(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = Path(self.tmp.name)
+        self.cfg = NS(arm_config={'LOGPATH': str(self.path), 'LOGLEVEL': 'INFO'})
+        self.root = logging.getLogger()
+        handlers, level = self.root.handlers[:], self.root.level
+        self.root.handlers = []
+        self.root.setLevel(logging.INFO)
+        def restore():
+            for handler in self.root.handlers[:]:
+                handler.close()
+            self.root.handlers, self.root.level = handlers, level
+        self.addCleanup(restore)
+        self.logs = load('arm/ripper/logger.py', {
+            'clean_up_logs', '_create_file_handler', 'setup_job_log', 'create_early_logger',
+        }, dict(os=os, uuid=uuid, logging=logging, cfg=self.cfg,
+                long_formatter=logging.Formatter('%(message)s'),
+                short_formatter=logging.Formatter('%(message)s')))
+
+    def test_all_retention_settings_preserve_old_open_logs(self):
+        (self.path / 'progress').mkdir()
+        for name in ('failed.log', 'progress/2.log'):
+            p = self.path / name
+            p.write_text('original')
+            os.utime(p, (1, 1))
+        with (self.path / 'failed.log').open('a') as writer:
+            for retention in (0, 1, 30):
+                self.logs['clean_up_logs'](str(self.path), retention)
+            writer.write('late failure')
+        self.assertEqual((self.path / 'failed.log').read_text(), 'originallate failure')
+        self.assertEqual((self.path / 'progress/2.log').read_text(), 'original')
+
+    def test_job_logs_unique_even_same_label_and_stage(self):
+        jobs = [NS(label='DISC', stage='1', disctype='dvd') for _ in range(2)]
+        for i, job in enumerate(jobs):
+            self.logs['setup_job_log'](job)
+            logging.info('sentinel-%s', i)
+        self.assertNotEqual(jobs[0].logfile, jobs[1].logfile)
+        self.assertNotIn('sentinel-1', (self.path / jobs[0].logfile).read_text())
+        self.assertIn('sentinel-1', (self.path / jobs[1].logfile).read_text())
+
+    def test_early_root_errors_persist(self):
+        self.logs['create_early_logger'](stdout=False, syslog=False)
+        logging.error('setup failure sentinel')
+        self.assertIn('setup failure sentinel', (self.path / 'arm.log').read_text())
+
+    def test_failed_job_log_creation_keeps_startup_sink(self):
+        self.logs['create_early_logger'](stdout=False, syslog=False)
+        with patch.object(uuid, 'uuid4', return_value=NS(hex='collision')):
+            (self.path / 'job-collision.log').write_text('old evidence')
+            with self.assertRaises(FileExistsError):
+                self.logs['setup_job_log'](NS(label='disc', stage='1', disctype='dvd'))
+        logging.error('log creation failed sentinel')
+        self.assertIn('log creation failed sentinel', (self.path / 'arm.log').read_text())
+        self.assertEqual((self.path / 'job-collision.log').read_text(), 'old evidence')
+
+    def test_viewer_script_parses_with_special_filename(self):
+        from jinja2 import Environment
+        template = (ROOT / 'arm/ui/logs/templates/logview.html').read_text().split('<script>')[1].split('</script>')[0]
+        script = Environment().from_string(template).render(file="disc' &<script>.log", mode='full')
+        js = self.path / 'viewer.js'
+        js.write_text(script)
+        subprocess.run(['node', '--check', str(js)], check=True, capture_output=True)
+
+    def mover(self):
+        return load('arm/ripper/utils.py', {'RipperException', 'move_files_main'},
+                    dict(os=os, logging=logging))['move_files_main']
+
+    def test_missing_episode_does_not_move_neighbor(self):
+        neighbor = self.path / 'Episode02.mkv'
+        neighbor.write_bytes(b'episode 2')
+        with self.assertRaisesRegex(Exception, 'missing'):
+            self.mover()(str(self.path / 'Episode01.mkv'), str(self.path / 'out.mkv'), str(self.path))
+        self.assertEqual(neighbor.read_bytes(), b'episode 2')
+        self.assertFalse((self.path / 'out.mkv').exists())
+
+    def test_collision_preserves_both_files(self):
+        source, target = self.path / 'source', self.path / 'target'
+        source.write_bytes(b'new'); target.write_bytes(b'old')
+        with self.assertRaisesRegex(Exception, 'Unable to install'):
+            self.mover()(str(source), str(target), str(self.path))
+        self.assertEqual(source.read_bytes(), b'new')
+        self.assertEqual(target.read_bytes(), b'old')
+
+    def test_atomic_install_success(self):
+        source, target = self.path / 'source', self.path / 'target'
+        source.write_bytes(b'generated rip')
+        self.mover()(str(source), str(target), str(self.path))
+        self.assertFalse(source.exists())
+        self.assertEqual(target.read_bytes(), b'generated rip')
+
+    def test_link_failure_retains_source(self):
+        source = self.path / 'source'; source.write_bytes(b'rip')
+        with patch.object(os, 'link', side_effect=OSError('cross-device fixture')):
+            with self.assertRaisesRegex(Exception, 'cross-device fixture'):
+                self.mover()(str(source), str(self.path / 'out'), str(self.path))
+        self.assertEqual(source.read_bytes(), b'rip')
+
+    def test_empty_and_symlink_sources_rejected(self):
+        empty = self.path / 'empty'; empty.touch()
+        link = self.path / 'link'; link.symlink_to(empty)
+        for source in (empty, link):
+            with self.assertRaises(Exception):
+                self.mover()(str(source), str(self.path / 'out'), str(self.path))
+        self.assertTrue(empty.exists())
+
+    def test_viewers_finite_and_tolerate_invalid_bytes(self):
+        ns = load('arm/ui/utils.py', {'generate_full_log', 'generate_arm_cat'}, {})
+        path = self.path / 'view.log'
+        payload = b'ARM: first\n' + b'x' * 100000 + b'\xff\nARM: FINAL\n'
+        path.write_bytes(payload)
+        self.assertEqual(''.join(ns['generate_full_log'](path)), payload.decode('utf8', errors='backslashreplace'))
+        self.assertEqual(''.join(ns['generate_arm_cat'](path)), 'ARM: first\nARM: FINAL\n')
+
+    def run_mkv(self, body, parser=None):
+        script = self.path / 'makemkvcon'
+        script.write_text('#!' + sys.executable + '\n' + body)
+        script.chmod(0o700)
+        self.logs['setup_job_log'](NS(label='fixture', stage='1', disctype='dvd'))
+        ns = dict(shutil=NS(which=lambda _: str(script)), shlex=shlex, collections=collections,
+                  subprocess=subprocess, logging=logging, os=os, enum=enum)
+        load('arm/ripper/makemkv.py', {'OutputType', 'MakeMkvRuntimeError', 'MakeMkvParserError', 'run'}, ns)
+        ns['parse_line'] = parser or (lambda line: (ns['OutputType'].MSG, line))
+        return ns
+
+    def test_mkv_captures_both_streams_at_info(self):
+        ns = self.run_mkv("import os\nos.write(1,b'stdout sentinel\\n')\nos.write(2,b'stderr \\xff sentinel\\n')\n")
+        list(ns['run'](['mkv', 'all'], ns['OutputType'].MSG))
+        text = next(self.path.glob('job-*.log')).read_text()
+        for sentinel in ('stdout sentinel', 'stderr \\xff sentinel', 'exit status: 0', 'MakeMKV command:'):
+            self.assertIn(sentinel, text)
+
+    def test_mkv_nonzero_raises_and_retains_output(self):
+        ns = self.run_mkv("import sys\nprint('failure sentinel', flush=True)\nsys.exit(7)\n")
+        with self.assertRaises(ns['MakeMkvRuntimeError']):
+            list(ns['run']([], ns['OutputType'].MSG))
+        text = next(self.path.glob('job-*.log')).read_text()
+        self.assertIn('failure sentinel', text)
+        self.assertIn('exit status: 7', text)
+
+    def test_parser_failure_terminates_child(self):
+        def parser(_):
+            raise RuntimeError('fatal parser fixture')
+        ns = self.run_mkv("import time\nprint('trigger', flush=True)\ntime.sleep(30)\n", parser)
+        start = time.monotonic()
+        with self.assertRaisesRegex(RuntimeError, 'fatal parser fixture'):
+            list(ns['run']([], ns['OutputType'].MSG))
+        self.assertLess(time.monotonic() - start, 5)
+
+    def main_ns(self, setup, main):
+        return load('arm/ripper/main.py', {'run_main'}, dict(
+            logging=logging, datetime=datetime, setup=setup, main=main,
+            utils=NS(RipperException=RuntimeError, notify=Mock()), constants=NS(NOTIFY_TITLE='ARM'),
+            db=NS(session=NS(commit=Mock())), JobState=NS(FAILURE=NS(value='failed'), SUCCESS=NS(value='success'))))
+
+    def test_setup_failure_without_job_returns_nonzero(self):
+        ns = self.main_ns(Mock(side_effect=RuntimeError('original setup failure')), Mock())
+        ns['utils'].notify.side_effect = RuntimeError('notification failure')
+        with self.assertLogs(level='ERROR') as logs:
+            self.assertEqual(ns['run_main'](), 1)
+        self.assertTrue(any('original setup failure' in line for line in logs.output))
+        ns['main'].assert_not_called()
+
+    def test_job_failure_persisted_without_start_time(self):
+        job = NS(status='running', start_time=None, eject=Mock())
+        ns = self.main_ns(lambda: ns.update(job=job), Mock(side_effect=RuntimeError('move failed')))
+        with self.assertLogs(level='ERROR'):
+            self.assertEqual(ns['run_main'](), 1)
+        self.assertEqual(job.status, 'failed')
+        self.assertEqual(job.errors, 'move failed')
+        self.assertEqual(job.job_length, '0:00:00')
+        ns['db'].session.commit.assert_called_once()
+
+    def test_existing_failure_not_overwritten_with_success(self):
+        job = NS(status='failed', start_time=None, eject=Mock())
+        ns = self.main_ns(lambda: ns.update(job=job), Mock())
+        with self.assertLogs(level='ERROR'):
+            self.assertEqual(ns['run_main'](), 1)
+        self.assertEqual(job.status, 'failed')
+
+    def test_success_returns_zero(self):
+        job = NS(status='running', start_time=datetime.datetime.now(), eject=Mock())
+        ns = self.main_ns(lambda: ns.update(job=job), Mock())
+        self.assertEqual(ns['run_main'](), 0)
+        self.assertEqual(job.status, 'success')
+
+
+if __name__ == '__main__':
+    unittest.main()
